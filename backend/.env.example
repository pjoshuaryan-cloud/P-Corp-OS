# Copy this file to .env and fill in real keys. .env itself is gitignored —
# never commit a real API key.
ANTHROPIC_API_KEY=sk-ant-...

# Optional — only needed for cloud text-to-speech (VoiceOutput.swift). Get
# an API key from elevenlabs.io (free tier available), pick a voice from
# their Voice Library, and copy its Voice ID here. Frank's speech falls
# back to silence (with a surfaced error, not a silent failure) if these
# aren't set — on-device speech isn't used as a fallback, since the whole
# point of this was on-device not being good enough.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional — only needed for mobile access via Tailscale (the /mobile web
# page). This Mac's Tailscale-assigned IP (run `tailscale ip` to find it),
# NOT your phone's. Never put a real public/LAN IP here — this opens a
# second listener on exactly this one address, reachable only through
# your private Tailscale network.
TAILSCALE_IP=

# Optional — only needed for Finance's automatic Luno balance tracking
# (app/luno_client.py). Generate a READ-ONLY API key at
# luno.com -> Settings -> API Keys (restrict permissions to balance/read
# only — this is a scoped, revocable credential, NOT your Luno account
# password, and this app never asks for that). Without these, Luno just
# stays untracked automatically — you can still log it manually like the
# other four Finance accounts.
LUNO_API_KEY_ID=
LUNO_API_KEY_SECRET=

# Optional — only needed for Gmail/Google Calendar integration. Create an
# OAuth 2.0 Client ID at console.cloud.google.com (APIs & Services ->
# Credentials -> Create OAuth client -> Desktop app), with the Gmail API
# and Google Calendar API enabled on that project and yourself added as a
# test user under the consent screen's Audience settings (avoids Google's
# full app-verification review, which is only needed for a public app used
# by strangers). This Client ID/Secret identify the app; the actual
# per-account access grant/refresh token is a separate, later step (the
# real OAuth authorization flow), not this credential pair alone.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Optional — only used by the Stage 3 migration tool (app/migration/) when
# replicating the SQLite databases into Postgres for cloud-independence
# testing. Defaults to a local-only Postgres instance if unset
# (postgresql://joshuapeters@localhost:5432/pcorp_migration_test) — the
# tool refuses to target any non-localhost host without an explicit
# --confirm-remote flag, so this is safe to leave unset for local testing.
MIGRATION_POSTGRES_DSN=
