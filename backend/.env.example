# Copy this file to .env and fill in real keys. .env itself is gitignored —
# never commit a real API key.
ANTHROPIC_API_KEY=sk-ant-...

# Optional — only needed for cloud text-to-speech (VoiceOutput.swift). Get
# an API key from elevenlabs.io (free tier available), pick a voice from
# their Voice Library, and copy its Voice ID here. Frank's speech falls
# back to silence (with a surfaced error, not a silent failure) if these
# aren't set — on-device speech isn't used as a fallback, since the whole
# point of this was on-device not being good enough.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional — only needed for mobile access via Tailscale (the /mobile web
# page). This Mac's Tailscale-assigned IP (run `tailscale ip` to find it),
# NOT your phone's. Never put a real public/LAN IP here — this opens a
# second listener on exactly this one address, reachable only through
# your private Tailscale network.
TAILSCALE_IP=

# Optional — only needed for the Proactive Triggers Layer's daily email
# digest (app/triggers.py). EMAIL_SMTP_USER is a real Gmail address;
# EMAIL_SMTP_APP_PASSWORD is a 16-character Google App Password (NOT your
# normal Gmail password — generate one at myaccount.google.com/apppasswords,
# requires 2-Step Verification to be on). EMAIL_DIGEST_TO defaults to
# EMAIL_SMTP_USER itself if left blank (send-to-self). If EMAIL_SMTP_USER/
# EMAIL_SMTP_APP_PASSWORD aren't set, the scheduler's send attempt raises
# and just retries next tick — no silent failure, but no digest either
# until these are filled in.
EMAIL_SMTP_USER=
EMAIL_SMTP_APP_PASSWORD=
EMAIL_DIGEST_TO=
