{
    "id": "media.alphamode.pcorpos.post",
    "name": "P Corp POST",
    "version": "0.0.1",
    "main": "index.html",
    "host": [
        {
            "app": "premierepro",
            "minVersion": "25.2.0"
        }
    ],
    "requiredPermissions": {
        "network": {
            "domains": "all"
        },
        "localFileSystem": "request"
    },
    "manifestVersion": 5,
    "entrypoints": [
        {
            "type": "panel",
            "id": "postPanel",
            "minimumSize": { "width": 320, "height": 240 },
            "maximumSize": { "width": 2000, "height": 2000 },
            "preferredDockedSize": { "width": 400, "height": 500 },
            "preferredFloatingSize": { "width": 400, "height": 500 },
            "label": {
                "default": "P Corp POST"
            },
            "icons": [
                {
                    "width": 23,
                    "height": 23,
                    "path": "icons/dark.png",
                    "scale": [1, 2],
                    "theme": ["darkest", "dark", "medium"]
                },
                {
                    "width": 23,
                    "height": 23,
                    "path": "icons/light.png",
                    "scale": [1, 2],
                    "theme": ["lightest", "light"]
                }
            ]
        }
    ],
    "icons": [
        {
            "width": 48,
            "height": 48,
            "path": "icons/plugin-icon.png",
            "scale": [1, 2],
            "theme": ["darkest", "dark", "medium", "lightest", "light", "all"],
            "species": ["pluginList"]
        }
    ]
}
